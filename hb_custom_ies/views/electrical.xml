<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_electrical_item_tree" model="ir.ui.view">
        <field name="name">electrical.item.tree</field>
        <field name="model">electrical.item</field>
        <field name="arch" type="xml">
            <list string="Electrical Items">
                <field name="name"/>
<!--                <field name="uom"/>-->
<!--                <field name="quantity"/>-->
<!--                <field name="unit_rate"/>-->
<!--                <field name="total"/>-->
            </list>
        </field>
    </record>

    <record id="view_electrical_item_form" model="ir.ui.view">
        <field name="name">electrical.item.form</field>
        <field name="model">electrical.item</field>
        <field name="arch" type="xml">
            <form string="Electrical Item">
                <sheet>
                    <group>
                        <field name="name"/>
<!--                        <field name="uom"/>-->
<!--                        <field name="quantity"/>-->
                        <field name="unit_rate" />
<!--                        <field name="total" readonly="1"/>-->
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_electrical_items" model="ir.actions.act_window">
        <field name="name">Electrical Items</field>
        <field name="res_model">electrical.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_electrical_root" name="Electrical"  parent="sale.menu_sale_config" action="action_electrical_items" sequence="10"/>
<!--    <menuitem id="menu_electrical_items" name="Items" parent="menu_electrical_root" action="action_electrical_items"/>-->
</odoo>
