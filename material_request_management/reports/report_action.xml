<odoo>
   <record id="material_request_report_action" model="ir.actions.report">
    <field name="name">Material Request Report</field>
    <field name="model">project.material.request</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">material_request_management.material_request_template</field>
    <field name="report_file">material_request_management.material_request_template</field>
    <field name="binding_type">report</field>
    <field name="print_report_name">'Material Request - %s' % object.name</field>
