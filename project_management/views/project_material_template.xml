<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_project_material_template_form" model="ir.ui.view">
        <field name="name">project.material.template.form</field>
        <field name="model">project.material.template</field>
        <field name="arch" type="xml">
            <form string="Costing Template">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                        </group>
                        <group>
                            <field name="project_discipline_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Materials">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="uom_id"/>
                                    <field name="is_material" force_save="1"/>
                                    <field name="product_uom_category_id" column_invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_project_material_template" model="ir.actions.act_window">
        <field name="name">Costing Templates</field>
        <field name="res_model">project.material.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_project_material_template_sale"
              name="Costing Templates"
              parent="sale.menu_sale_config"
              action="action_project_material_template"
              sequence="10"/>

    <menuitem id="menu_project_material_template"
              name="Costing Templates"
              parent="project.menu_project_config"
              action="action_project_material_template"
              sequence="50"/>
</odoo>
