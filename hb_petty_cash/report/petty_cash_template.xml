<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_petty_cash_document">
        <t t-set="doc" t-value="doc.with_context(lang='en_US')"/>

        <!-- 1. FIXED HEADER -->
        <div class="header" style="font-family: Helvetica, sans-serif; padding: 0; margin: 0; width:100%;">
            <!-- WATERMARK -->
            <div style="position: fixed; top: 500px; left: 0; width: 100%; text-align: center; z-index: -1000; opacity: 0.1;">
                <img t-if="doc.company_id.background_image"
                     t-att-src="image_data_uri(doc.company_id.background_image)"
                     style="width: 200px; height: auto; display: block; margin: 0 auto;"/>
            </div>

            <div style="width: 100% !important; position: absolute; left: 0; top: 0; z-index: -1;">
                <img src="/ies_pdf_reports/static/src/images/header.jpg" style="width: 100% !important; display: block;"/>
            </div>

            <div class="row m-0" style="padding-top: 180px; padding-left: 20px; padding-right: 20px; width: 100%; position: relative;">
                <div class="col-12 text-end">
                    <h2 style="color: #2c3e50; font-weight: bold; font-size: 24px; margin: 0;">PETTY CASH</h2>
                </div>
            </div>
        </div>

        <!-- 2. MAIN CONTENT -->
        <div class="article" t-att-data-oe-model="doc._name" t-att-data-oe-id="doc.id"
             style="font-size:11px; font-family: Helvetica, sans-serif; padding: 260px 25px 0px 25px;">
            <div class="page">

                <!-- Info Section -->
                <table class="table table-bordered mb-7" style="width:100%; border-collapse: collapse; border: 1px solid #dee2e6;">
                    <tr style="background-color: #f8f9fa;">
                        <td style="width: 18%; padding: 8px;"><strong>Statement No.</strong></td>
                        <td style="width: 32%; padding: 8px;"><span t-field="doc.statement_no"/></td>
                        <td style="width: 18%; padding: 8px;"><strong>Requested Date</strong></td>
                        <td style="width: 32%; padding: 8px;"><span t-field="doc.requested_date" t-options='{"widget": "date"}'/></td>
                    </tr>
                    <tr>
                        <td style="padding: 8px;"><strong>Narration</strong></td>
                        <td style="padding: 8px;"><span t-field="doc.narration"/></td>
                        <td style="padding: 8px;"><strong>Petty Cash No.</strong></td>
                        <td style="padding: 8px;"><span t-field="doc.request_number"/></td>
                    </tr>
                </table>

                <!-- 10 LINE PAGINATION LOGIC -->
                <t t-set="chunk_size" t-value="18"/>
                <t t-set="lines" t-value="doc.line_ids"/>
                <t t-set="pages" t-value="[lines[i:i+chunk_size] for i in range(0, len(lines), chunk_size)]"/>

                <t t-set="sl_no" t-value="1"/>
                <t t-foreach="pages" t-as="page">
                    <table style="border: 1px solid #000 !important; width:100%; border-collapse: separate !important; border-spacing: 0 !important; margin-top: 10px;">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th style="border: 1px solid #000; padding: 8px; width: 8%;" class="text-center">SL No.</th>
                                <th style="border: 1px solid #000; padding: 8px; width: 57%;" class="text-start">PETTY EXPENSES</th>
                                <th style="border: 1px solid #000; padding: 8px; width: 15%;" class="text-center">DIVISION</th>
                                <th style="border: 1px solid #000; padding: 8px; width: 20%;" class="text-end">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="page" t-as="line">
                                <tr style="height: 30px;">
                                    <td style="border-left:1px solid #000; border-right:1px solid #000;border-top: 0 !important; border-bottom: 0 !important; text-align: center;"><t t-esc="sl_no"/></td>
                                    <td style="border-left:1px solid #000; border-right:1px solid #000;border-top: 0 !important; border-bottom: 0 !important; padding-left: 5px;"><span t-field="line.particulars"/></td>
                                    <td style="border-left:1px solid #000; border-right:1px solid #000;border-top: 0 !important; border-bottom: 0 !important; text-align: center;"><span t-field="line.division"/></td>
                                    <td style="border-left:1px solid #000; border-right:1px solid #000;border-top: 0 !important; border-bottom: 0 !important; text-align: right; padding-right: 5px;">
                                        <t t-esc="'%.3f' % line.amount"/>
                                    </td>
                                    <t t-set="sl_no" t-value="sl_no + 1"/>
                                </tr>
                            </t>
                            <!-- blank rows -->
                            <t t-set="blank_rows" t-value="chunk_size - len(page)"/>
                            <t t-foreach="range(blank_rows)" t-as="i">
                                <tr style="height: 30px;">
                                    <td t-foreach="range(4)" t-as="j" style="border-left:1px solid #000; border-right:1px solid #000;border-top: 0 !important; border-bottom: 0 !important;"/>
                                </tr>
                            </t>
                        </tbody>
                        <!-- Total line on last page -->
                        <t t-if="page == pages[-1]">
                            <tr style="border-top: 1px solid #000; font-weight: bold;">
                                <td colspan="3" style="border:1px solid #000; padding: 8px; text-align: right;">TOTAL</td>
                                <td style="border:1px solid #000; padding: 8px; text-align: right;">
                                    <span t-esc="'{0:,.3f}'.format(doc.total_amount)"/>
                                </td>
                            </tr>
                        </t>
                    </table>

                    <!-- Totals and Words -->
                    <t t-if="page == pages[-1]">
                        <div class="row" style="margin-top: 20px;">
                            <div class="col-12">
                                <strong>Amount In Words :</strong>
                                <span style="text-transform: capitalize;" t-esc="doc.currency_id.with_context(lang='en_US').amount_to_text(doc.total_amount) + ' Only'"/>
                            </div>
                        </div>

                        <!-- Signature Section -->
                        <div class="row" style="margin-top: 100px;">
                            <div class="col-6 text-start">
                                <div style="width: 150px; border-top: 1px solid #000; margin-bottom: 5px;"/>
                                <strong>PREPARED BY</strong>
                            </div>
                            <div class="col-6 text-end">
                                <div style="float: right; width: 150px; border-top: 1px solid #000; margin-bottom: 5px;"/>
                                <br style="clear: both;"/>
                                <strong>APPROVED BY</strong>
                            </div>
                        </div>
                    </t>

                    <!-- Page break -->
                    <t t-if="len(pages) &gt; 1 and page != pages[-1]">
                        <div style="page-break-after: always;"/>
                    </t>
                </t>
            </div>
        </div>

        <!-- 3. FIXED FOOTER -->
        <div class="footer" style="padding: 0 !important; margin: 0 !important; width: 100%!important;position:relative">

            <div class="text-center" style="font-size: 10px; color: #777; padding: 5px 20px;position:absolute;right:0px">
                Page <span class="page"/> of <span class="topage"/>
            </div>

            <div style="width: 100%; margin: 0; padding: 0;">
                <img src="/ies_pdf_reports/static/src/images/footer.jpg" style="width: 100% !important; display: block; margin: 0; padding: 0;"/>
            </div>

        </div>
    </template>

    <template id="report_petty_cash_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="hb_petty_cash.report_petty_cash_document"/>
            </t>
        </t>
    </template>
</odoo>