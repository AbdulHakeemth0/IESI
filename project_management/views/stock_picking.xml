<?xml version="1.0" ?>
<odoo>
    <record id="stock_picking_poject_custom_inherit_form" model="ir.ui.view">
        <field name="name">stock.picking.project.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='sale_id']" position="after">
                <field name="task_id"/>
            </xpath>
            <xpath expr="//field[@name='move_ids_without_package']//list/field[@name='product_id']"
                   position="after">
                <field name="project_material_id"/>
            </xpath>
        </field>
    </record>
</odoo>
