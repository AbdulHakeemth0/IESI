<odoo>
    <data>
        <template id="material_request_template">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-set="doc" t-value="o"/>
                    <t t-call="web.basic_layout">
                        <div class="header"
                             style="font-family: Helvetica, sans-serif; padding: 0; margin: 0; width: 100%;">
                            <div style="width: 100% !important; position: absolute; left: 0; top: 0; margin: 0; padding: 0; z-index: -1;">
                                <img src="/ies_pdf_reports/static/src/images/header.jpg"
                                     style="width: 100%!important; margin: 0; padding: 0; display: block;"/>
                            </div>
                            <div style="position: fixed; top: 500px; left: 0; width: 100%; text-align: center; z-index: -1000; opacity: 0.08; pointer-events: none;">
                                <img t-if="o.company_id.background_image"
                                     t-att-src="image_data_uri(o.company_id.background_image)"
                                     style="width: 200px; height: auto;"/>
                            </div>
                            <div class="row m-0"
                                 style="padding-top: 165px; padding-left: 20px; padding-right: 20px; width: 100%; position: relative;">
                                <div class="col-12 text-end" style="margin-top: -20px;">
                                    <h2 style="color: #2c3e50; font-weight: bold; font-size: 24px; margin: 0; text-align: right;">
                                        Material Request
                                    </h2>
                                </div>
                            </div>
                        </div>

                        <br/>
                        <br/>
                        <br/>

                        <!-- BODY -->
                        <div class="page" style="font-size:16px; font-family: Helvetica, sans-serif; line-height: 1.5;">
                            <!-- DETAILS -->
                            <table style="width: 100%; margin: 30px auto; border-collapse: collapse;">
                                <tr>
                                    <td style="border:1px solid #000; padding:8px;">
                                        <b>Doc.No</b>
                                    </td>
                                    <td style="border:1px solid #000; padding:8px;">
                                        <t t-esc="o.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="border:1px solid #000; padding:8px;">
                                        <b>Doc. Date</b>
                                    </td>
                                    <td style="border:1px solid #000; padding:8px;">
                                        <t t-if="o.date">
                                            <t t-esc="o.date.strftime('%d-%m-%Y')"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding: 8px; border: 1px solid #000;">
                                        <b>Req. By</b>
                                    </td>
                                    <td style="padding: 8px; border: 1px solid #000;">
                                        <t t-esc="o.requested_by"/>
                                    </td>
                                </tr>

                                <tr>
                                    <td style="border:1px solid #000; padding:8px;">
                                        <b>Remark</b>
                                    </td>
                                    <td style="border:1px solid #000; padding:8px;">
                                        <t t-esc="o.notes"/>
                                    </td>
                                </tr>
                            </table>

                            <!-- TABLE -->
                            <t t-set="chunk_size" t-value="10"/>
                            <t t-set="materials" t-value="o.material_ids"/>
                            <t t-set="pages" t-value="[materials[i:i+chunk_size] for i in range(0, len(materials), chunk_size)] if len(materials) else [materials]"/>

                            <t t-set="sl_no" t-value="1"/>
                            <t t-foreach="pages" t-as="page">

                                <table style="width:100%; border-collapse: collapse; border:1px solid black;border-bottom:1px solid black;margin-top:100px;">
                                    <thead>
                                        <tr style="background-color: #BDD7EE;">
                                            <th style="border:1px solid black;">SN</th>
                                            <th style="border:1px solid black;">Product</th>
                                            <th style="border:1px solid black;">Description</th>
                                            <th style="border:1px solid black;">UOM</th>
                                            <th style="border:1px solid black;">Qty</th>
                                            <th style="border:1px solid black;">Remarks</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <t t-foreach="page" t-as="line">
                                            <t t-set="bottom_border"
                                               t-value="'1px solid black' if line_last and len(page) == chunk_size else '1px solid transparent'"/>

                                            <tr>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{bottom_border}};">
                                                    <t t-esc="sl_no"/>
                                                </td>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{bottom_border}};">
                                                    <t t-esc="line.product_id.name"/>
                                                </td>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{bottom_border}};">
                                                    <t t-esc="line.name"/>
                                                </td>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{bottom_border}};">
                                                    <t t-esc="line.uom_id.name"/>
                                                </td>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{bottom_border}};">
                                                    <t t-esc="line.quantity"/>
                                                </td>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{bottom_border}};"/>
                                            </tr>

                                            <t t-set="sl_no" t-value="sl_no + 1"/>
                                        </t>
                                        <!-- blank rows -->
                                        <t t-set="blank_rows" t-value="chunk_size - len(page)"/>
                                        <t t-foreach="range(blank_rows)" t-as="i">
                                            <t t-set="blank_bottom_border"
                                               t-value="'1px solid black' if i_last else '1px solid transparent'"/>
                                            <tr style="height: 30px;">
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{blank_bottom_border}};"/>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{blank_bottom_border}};"/>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{blank_bottom_border}};"/>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{blank_bottom_border}};"/>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{blank_bottom_border}};"/>
                                                <td t-attf-style="border-left:1px solid black; border-right:1px solid black; padding:6px; border-bottom: {{blank_bottom_border}};"/>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                                <t t-if="page_last">
                                    <br/>
                                    <br/>
                                    <div class="row" style="margin-top: 100px;">
                                        <div class="col-6">
                                            <div>
                                                <b>Prepared By</b>
                                            </div>
                                            <div>
                                                <t t-esc="o.user_id.name"/>
                                            </div>
                                        </div>
                                        <div class="col-6 text-end" style="padding-right: 20px;">
                                            <div>
                                                <b>Approved By</b>
                                            </div>
                                            <div>
                                                <t t-esc="o.approved_by.name"/>
                                            </div>
                                        </div>
                                    </div>
                                </t>

                                <!-- Page break ONLY if more material lines remain -->
                                <t t-if="not page_last">
                                    <div style="page-break-after: always;"></div>
                                </t>

                            </t>
                        </div>
                        <!-- FOOTER -->
                        <div class="footer" style="width:100%; text-align:center; font-size:10px;">
                            <img src="/material_request_management/static/src/images/footer.jpg"
                                 style="width:100%; margin-top:5px;"/>
                            <div style="text-align:right;">
                                Page
                                <span class="page"/>
                                of
                                <span class="topage"/>
                            </div>
                        </div>

                    </t>
                </t>
            </t>
        </template>
    </data>
</odoo>
