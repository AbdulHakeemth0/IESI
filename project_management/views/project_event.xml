<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="project_event_view_form" model="ir.ui.view">
        <field name="name">project.event.view.form</field>
        <field name="model">project.event</field>
        <field name="arch" type="xml">
            <form string="Project_event">
                <sheet>
                    <group>
                        <field name="name"/>
                        <!-- Add your fields here -->
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- List View -->
    <record id="project_event_view_list" model="ir.ui.view">
        <field name="name">project.event.view.list</field>
        <field name="model">project.event</field>
        <field name="arch" type="xml">
            <list string="Project_event">
                <field name="name"/>
                <!-- Add your fields here -->
            </list>
        </field>
    </record>
    
    <!-- Action -->
    <record id="project_event_action" model="ir.actions.act_window">
        <field name="name">Project event</field>
        <field name="res_model">project.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first project event!
            </p>
        </field>
    </record>
    
    <!-- Menu -->
    <menuitem id="project_event_menu"
              name="Project event"
              action="project_event_action"
              parent="project.menu_project_config"
              sequence="51"/>
</odoo>