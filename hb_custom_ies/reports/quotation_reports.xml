                            <table style="width: 100%; border-collapse: collapse; border: 1px solid black; font-size: 12px;">
                                <thead>
                                    <tr style="background-color: #90D5FF; color: black;"> <!-- light green background -->
                                        <th style="border: 1px solid black; padding: 6px; width:50%;">Scope
                                            Description
                                        </th>
                                        <th style="border: 1px solid black; padding: 6px; width:10%;">Unit</th>
                                        <th style="border: 1px solid black; padding: 6px; width:10%;">Quantity</th>
                                        <th style="border: 1px solid black; padding: 6px; width:15%;">Rate</th>
                                        <th style="border: 1px solid black; padding: 6px; width:15%;">Amount(<t
                                                t-esc="o.currency_id.name"/>)
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="order_lines" t-as="line">
                                        <tr style="height:25px;">
                                            <td style="border: 1px solid black; padding: 6px;">
                                                <t t-esc="line.name"/>
                                            </td>
                                            <t t-if="line.product_id">
                                                <td style="border: 1px solid black; padding: 6px;">
                                                    <t t-esc="line.unit or '-'"/>
                                                </td>
                                                <td style="border: 1px solid black; padding: 6px;">
                                                    <t t-esc="line.product_uom_qty"/>
                                                </td>
                                                <td style="border: 1px solid black; padding: 6px;">
                                                    <t t-esc="'%.2f' % line.price_unit"/>
                                                </td>
                                                <td style="border: 1px solid black; padding: 6px;">
                                                    <!--                                                    <t t-esc="'%.2f' % line.price_subtotal"/>-->
                                                    <span t-esc="line.price_subtotal"
                                                          t-options="{'widget': 'monetary', 'display_currency': currency}"/>
                                                </td>
                                            </t>
                                            <t t-else="">

                                                <td style="border: 1px solid black; padding: 6px;"></td>
                                                <td style="border: 1px solid black; padding: 6px;"></td>
                                                <td style="border: 1px solid black; padding: 6px;"></td>
                                                <td style="border: 1px solid black; padding: 6px;"></td>
                                            </t>
                                        </tr>
                                        <t t-set="sl_no" t-value="sl_no + 1"/>
                                    </t>
                                    <tr>
