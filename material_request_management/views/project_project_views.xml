<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Project form view -->
    <record id="project_project_mr_inherit_view_form" model="ir.ui.view">
        <field name="name">project.project.mr.view.form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_open_share_project_wizard']" position="after">
                <button name="action_create_mr" type="object"
                        string="Create MR" class="btn-primary"/>
            </xpath>
            <xpath expr='//button[@name="action_view_tasks"]' position='after'>
                <button class="oe_stat_button" type="object" name="action_view_mr"
                        icon="fa-credit-card">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">MR</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
