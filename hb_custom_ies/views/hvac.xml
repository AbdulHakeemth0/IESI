<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hvac_item_tree" model="ir.ui.view">
        <field name="name">hvac.item.tree</field>
        <field name="model">hvac.item</field>
        <field name="arch" type="xml">
            <list string="HVAC Items">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_hvac_item_form" model="ir.ui.view">
        <field name="name">hvac.item.form</field>
        <field name="model">hvac.item</field>
        <field name="arch" type="xml">
            <form string="HVAC Item">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="hv_unit_rate" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hvac_items" model="ir.actions.act_window">
        <field name="name">HVAC Items</field>
        <field name="res_model">hvac.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hvac_root" name="HVAC"  parent="sale.menu_sale_config" action="action_hvac_items" sequence="10"/>
<!--    <menuitem id="menu_hvac_items" name="Items" parent="menu_hvac_root" action="action_hvac_items"/>-->

