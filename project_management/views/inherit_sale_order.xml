<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_form_project_inherit" model="ir.ui.view">
        <field name="name">sale.order.form.project.inherit</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="material_template_ids"  options="{'no_create': True}" widget="many2many_tags" domain="[('project_discipline_id', 'in', project_discipline_ids)]"/>
            </xpath>
        </field>
    </record>
</odoo>