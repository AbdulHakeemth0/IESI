<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="iesi_report_invoice_document">
<!--        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>-->

        <!-- 1. FIXED HEADER (Repeats on every page) -->
        <div class="header" style="font-family: Helvetica, sans-serif;padding: 0; margin: 0;width:100%;">
            <!-- WATERMARK -->
            <div style="position: fixed; top: 500px; left: 0; width: 100%; text-align: center; z-index: -1000; opacity: 0.08; pointer-events: none;">
                <img t-if="o.company_id.background_image" t-att-src="image_data_uri(o.company_id.background_image)" style="width: 200px; height: auto;"/>
            </div>
            <div style="width: 100% !important; position: absolute; left: 0; top: 0; margin: 0; padding: 0;z-index: -1;">

                    <img src="/ies_pdf_reports/static/src/images/header.jpg" style="width: 100%!important;margin: 0; padding: 0; display: block;"/>
                </div>
        </div>

        <!-- 2. MAIN CONTENT AREA -->
        <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-size:15px; font-family: Helvetica, sans-serif;padding: 200px 20px 0px 20px;!important">
            <div class="page">

                <!-- TOP SECTION: EXACT ALIGNMENT (Left Side Details | Right Side Info) -->
                <div class="row mt-4">
                    <!-- LEFT SIDE: Innovative Details & To Details -->
                    <div class="col-7" style="padding-left: 15px;">
<!--                        <div style="margin-bottom: 25px;">-->
<!--                            <strong t-field="o.company_id.name" style="font-size: 14px; color: #000;"/><br/>-->
<!--                            <span t-field="o.company_id.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": True}'/>-->
<!--&lt;!&ndash;                            <t t-if="o.company_id.cr_no"><div>CR NO: <t t-esc="o.company_id.cr_no"/></div></t>&ndash;&gt;-->
<!--                        </div>-->

                        <div style="margin-top: 35px;">
                            <strong style="text-decoration: underline;">To,</strong><br/>
                            <strong t-field="o.partner_id.name" style="font-size: 13px;"/><br/>
                            <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": True}'/>
                            <t t-if="o.partner_id.vat">VATIN: <t t-esc="o.partner_id.vat"/><br/></t>
                            <t t-if="o.partner_id.cr_no">CR NO: <t t-esc="o.partner_id.cr_no"/></t>
                        </div>
                    </div>

                    <!-- RIGHT SIDE: TAX INVOICE DATA -->
                    <div class="col-5 text-end" style="padding-right: 15px;">
                        <h2 style="font-weight: bold; color: #000; margin-bottom: 8px; font-size: 26px;">TAX INVOICE</h2>
                        <div style="line-height: 1.7; font-size: 13px;">
                            <strong>Date:</strong> <span t-field="o.invoice_date" t-options='{"widget": "date", "format": "dd-MM-yyyy"}'/><br/>
                            <strong>Invoice No:</strong> <span t-field="o.name"/><br/>
<!--                             <strong>Due Date:</strong> <span t-field="o.invoice_date_due" t-options='{"widget": "date", "format": "dd-MM-yyyy"}'/><br/>-->

                            <strong>LPO No:</strong> <span t-field="o.lpo_no"/><br/>
<!--                            <strong>payment terms:</strong> <span t-field="o.invoice_payment_term_id"/><br/>-->
                            <t t-if="o.company_id.cr_no">CR: <t t-esc="o.company_id.cr_no"/><br/></t>
                            <t t-if="o.company_id.vat">VATIN: <t t-esc="o.company_id.vat"/><br/></t> <br/><br />



                        </div>
                    </div>

                </div>

                <div style="padding-top:18px;padding-left:18px">
                <strong>Project:</strong>
                         <span t-field="o.project_name"/></div>
                <!-- TABLE SECTION: FIXED 10 LINES -->
               <!-- 8 LINE PAGINATION LOGIC -->
                <t t-set="chunk_size" t-value="10"/>
                <t t-set="order_lines" t-value="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product' or not l.display_type)"/>
                <t t-set="pages" t-value="[order_lines[i:i+chunk_size] for i in range(0, len(order_lines), chunk_size)]"/>

                <t t-set="sl_no" t-value="1"/>
                <t t-foreach="pages" t-as="page_lines">
                    <table class="table table-bordered mt-5" style="border: 1px solid #000; width:100%; border-collapse: separate !important; border-spacing: 0 !important;">
                        <thead style="background-color: #f8f9fa;">
                            <tr>
                                <th style="border-left:1px solid #000; border-right:1px solid #000;border-bottom: 1px solid #000; width: 8%; text-align: center; padding: 8px;">SN</th>
                                <th style="border-left:1px solid #000; border-right:1px solid #000;border-bottom: 1px solid #000; width: 74%; padding: 8px;">DESCRIPTION</th>
<!--                                <th style="border-left:1px solid #000; border-right:1px solid #000;border-bottom: 1px solid #000; width: 17%; text-align: right; padding: 8px;">RATE</th>-->
                                <th style="border-left:1px solid #000; border-right:1px solid #000;border-bottom: 1px solid #000; width: 18%; text-align: right; padding: 8px;">AMOUNT</th>
                            </tr>
                        </thead>
                        <tbody>
                            <!-- page_lines -->
                            <t t-foreach="page_lines" t-as="line">
                                <tr style="height: 35px;">
                                    <td style="border-left: 1px solid #000; border-right: 1px solid #000;border-top: 0 !important; border-bottom: 0 !important; text-align: center;"><t t-esc="sl_no"/></td>
                                    <td style="border-left: 1px solid #000; border-right: 1px solid #000;border-top: 0 !important; border-bottom: 0 !important; padding-left: 8px;"><span t-field="line.description"/></td>
<!--                                    <td style="border-left: 1px solid #000; border-right: 1px solid #000;border-top: 0 !important; border-bottom: 0 !important; text-align: right; padding-right: 8px;">-->
<!--                                        <span t-field="line.price_unit" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>-->
<!--                                    </td>-->
                                    <td style="border-left: 1px solid #000; border-right: 1px solid #000;border-top: 0 !important; border-bottom: 0 !important; text-align: right; padding-right: 8px;">
                                        <span t-field="line.price_subtotal" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                    <t t-set="sl_no" t-value="sl_no + 1"/>
                                </tr>
                            </t>
                            <!-- blank lines -->
                            <t t-foreach="range(max(0, chunk_size - len(page_lines)))" t-as="i">
                                <tr style="height: 35px;">
                                    <td style="border-left: 1px solid #000; border-right: 1px solid #000;border-top: 0 !important; border-bottom: 0 !important;"/><td style="border-left: 1px solid #000; border-right: 1px solid #000;border-top: 0 !important; border-bottom: 0 !important;"/><td style="border-left: 1px solid #000; border-right: 1px solid #000;border-top: 0 !important; border-bottom: 0 !important;"/>
                                </tr>
                            </t>
                            <!-- SUB TOTAL  -->
                            <t t-if="page_lines == pages[-1]">
                                <tr style="font-weight: bold;">
                                    <td colspan="2" style="border-left:1px solid #000; border-right:1px solid #000;border-top: 1px solid #000!important; border-bottom: 0 !important; padding: 10px; text-align: left;">SUB TOTAL</td>
                                    <td style="border-left:1px solid #000; border-right:1px solid #000;border-top: 1px solid #000!important; border-bottom: 0 !important; padding: 10px; text-align: right;">
                                        <span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Totals & Signatures - (pages[-1])  -->
                    <t t-if="page_lines == pages[-1]">
                         <!-- TOTALS SECTION -->
                <div class="row" style="margin-top: 25px;">
                    <div class="col-7">
                        <strong>Amount in Words:</strong><br/>
                        <span style="text-transform: capitalize; font-style: italic;" t-esc="o.currency_id.amount_to_text(o.amount_total) + ' Only'"/>
                    </div>
                    <div class="col-5">
                        <table style="width: 100%; border: 0 !important; border-spacing: 0 !important; border-collapse: separate !important;">
                            <tr>
                                <td style="text-align: right; padding: 5px;">Sub Total</td>
                                <td style="text-align: right; padding: 5px; width: 40%;"><span t-field="o.amount_untaxed" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr>
                                <td style="text-align: right; padding: 5px;">VAT</td>
                                <td style="text-align: right; padding: 5px;"><span t-field="o.amount_tax" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                            <tr style="background-color: #f8f9fa; ">
                                <td style="text-align: right; padding: 5px;border-top:1px solid #000!important; border-bottom:0px!important;"><strong>TOTAL AMOUNT</strong></td>
                                <td style="text-align: right; padding: 5px; border-top:1px solid #000!important; border-bottom:0px!important;"><strong t-field="o.amount_total" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                            </tr>
                        </table>
                    </div>
                </div>

                <!-- SIGNATURE SECTION -->
                <div class="row" style="margin-top: 130px;">
                    <div class="col-6">
                        <div style="width: 170px; border-top: 1px solid #000; margin-bottom: 8px;"/>
                        <strong>Received by, Name/Signature</strong>
                    </div>
                    <div class="col-6 text-end">
                        <div style="float: right; width: 170px; border-top: 1px solid #000; margin-bottom: 8px;"/>
                        <br style="clear: both;"/>
                        <strong>Authority Signature</strong>
                    </div>
                </div>
                    </t>

                    <!-- next page logic -->
                    <t t-if="len(pages) &gt; 1 and page_lines != pages[-1]">
                        <div style="page-break-after: always;"/>
                    </t>
                </t>

            </div>
        </div>

        <!-- 3. FIXED FOOTER (Repeats on every page) -->
        <div class="footer" style="padding: 0 !important; margin: 0 !important; width: 100%!important;position:relative">
             <div class="text-center" style="font-size: 10px; color: #666; margin-top: 5px;position:absolute;right:0px">
                Page <span class="page"/> of <span class="topage"/>
            </div>
            <div class="width: 100%; margin: 0; padding: 0;">
                <img src="/ies_pdf_reports/static/src/images/footer.jpg" style="width: 100% !important; display: block; margin: 0; padding: 0;"/>
            </div>

        </div>
    </template>

    <!-- REPORT ACTION CALL -->
    <template id="iesi_report_invoice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="ies_pdf_reports.iesi_report_invoice_document"/>
            </t>
        </t>
    </template>
</odoo>