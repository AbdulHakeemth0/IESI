<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="report_payment_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>

                <!-- 1. FIXED HEADER -->
                <div class="header" style="font-family: Helvetica, sans-serif; padding: 0; margin: 0; width:100%;">
                    <div style="position: fixed; top: 500px; left: 0; width: 100%; text-align: center; z-index: -1000; opacity: 0.1;">
                        <img t-if="o.company_id.background_image"
                             t-att-src="image_data_uri(o.company_id.background_image)"
                             style="width: 200px; height: auto; display: block; margin: 0 auto;"/>
                    </div>

                    <div style="width: 100% !important; position: absolute; left: 0; top: 0; margin: 0; padding: 0; z-index: -1;">
                        <img src="/ies_pdf_reports/static/src/images/header.jpg" style="width: 100% !important; margin: 0; padding: 0; display: block;"/>
                    </div>

                    <!--  (Receipt vs Payment) -->
                    <div class="row m-0" style="padding-top: 165px; padding-left: 20px; padding-right: 20px; width: 100%; position: relative;">
                        <div class="col-12 text-end">
                            <h2 style="color: #2c3e50; font-weight: bold; font-size: 24px; margin: 0;">
                                <t t-if="o.payment_type == 'Receive Money'">RECEIPT VOUCHER</t>
                                <t t-else="">PAYMENT ADVISE</t>
                            </h2>
                        </div>
                    </div>
                </div>

                <!-- 2. MAIN CONTENT AREA -->
                <div class="article" t-att-data-oe-model="o._name" t-att-data-oe-id="o.id" style="font-size:11px; font-family: Helvetica, sans-serif; padding: 210px 20px 0px 20px;">
                    <div class="page">

                        <div class="row mb-3" style="margin-top: 10px;">
                            <div class="col-6">
                                <div style="background-color: #f8f9fa; padding: 8px; font-weight: bold; border-bottom: 1px solid #dee2e6;">
                                    <t t-if="o.payment_type == 'Receive Money'">Received From:</t>
                                    <t t-else="">Pay To (Party):</t>
                                </div>
                                <div style="padding: 8px; min-height: 80px;">
                                    <strong t-field="o.partner_id"/><br/>
                                    <span t-field="o.partner_id" t-options='{"widget": "contact", "fields": ["address", "phone", "email"], "no_marker": True}'/>
                                </div>
                            </div>
                            <div class="col-6">
                                <table class="table table-sm table-borderless" style="width: 100%;">
                                    <tr><td><strong>Voucher No</strong></td><td>: <span t-field="o.name"/></td></tr>
                                    <tr><td><strong>Date</strong></td><td>: <span t-field="o.date"/></td></tr>
                                    <tr><td><strong>Pay Mode</strong></td><td>: <span t-field="o.bank_journal_id"/></td></tr>
                                    <tr><td><strong>Drawn On</strong></td><td>: <span t-field="o.bank_journal_id.default_account_id.name"/></td></tr>
                                </table>
                            </div>
                        </div>

                        <!-- PDC DETAILS TABLE (2 Columns, 3 Rows) -->
                        <div class="row mb-3">
                            <div class="col-12">
                                <table class="table table-bordered table-sm" style="width:100%; border-collapse: collapse; border: 1px solid #dee2e6;">
                                    <tr style="background-color: #f8f9fa;">
                                        <td style="width: 50%;  padding: 5px;"><strong>Ref No: </strong> <span t-field="o.ref_no"/></td>
                                        <td style="width: 50%; padding: 5px;"><strong>Cheque Number: </strong> <span t-field="o.check_number"/></td>
                                    </tr>
                                    <tr>
                                        <td style=" padding: 5px;"><strong>Cheque Date: </strong> <span t-field="o.check_date"/></td>
                                        <td style=" padding: 5px;"><strong>Cheque Amount: </strong> <span t-field="o.check_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/></td>
                                    </tr>
                                    <tr>
                                        <td style=" padding: 5px;"><strong>Payment Type: </strong> <span t-field="o.payment_type"/></td>
                                        <td style=" padding: 5px;"><strong>Memo: </strong> <span t-field="o.memo"/></td>
                                    </tr>
                                </table>
                            </div>
                        </div>

                        <!-- PAGINATION LOGIC -->
                        <t t-set="chunk_size" t-value="12"/>
                        <t t-set="all_lines" t-value="o.payment_line_ids"/>
                        <t t-set="pages" t-value="[all_lines[i:i+chunk_size] for i in range(0, len(all_lines), chunk_size)] if len(all_lines) > 0 else [[]]"/>

                        <t t-foreach="pages" t-as="page">
                           <table class="table table-bordered" style="border: 1px solid #000 !important; width:100%; border-collapse: separate !important; border-spacing: 0 !important; margin-top: 5px;">
    <thead style="background-color: #f8f9fa;">
        <tr>
            <th style="border: 1px solid #000; padding: 5px; font-size:10px;">Date Issued</th>
            <th style="border: 1px solid #000; padding: 5px; font-size:10px;">Description</th>
            <th style="border: 1px solid #000; padding: 5px; font-size:10px;">Bill Ref</th>
            <th style="border: 1px solid #000; padding: 5px; font-size:10px;" class="text-end">Orig. Amount</th>
            <th style="border: 1px solid #000; padding: 5px; font-size:10px;" class="text-end">Deduction</th>
            <th style="border: 1px solid #000; padding: 5px; font-size:10px;" class="text-end">Balance</th>
            <th style="border: 1px solid #000; padding: 5px; font-size:10px;" class="text-end">Paid Amount</th>
        </tr>
    </thead>
    <tbody>
        <t t-foreach="page" t-as="line">
            <tr style="height: 30px;">
                <td style="border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px;"><span t-field="line.invoice_date"/></td>
                <td style="border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px;"><span t-field="line.invoice_no"/></td>
                <td style="border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px;"><span t-field="line.move_ref"/></td>
                <td style="border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px;" class="text-end"><span t-field="line.amount"/></td>
                <td style="border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px;" class="text-end"><span t-field="line.deduction_amount"/></td>
                <td style="border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px;" class="text-end"><span t-field="line.balance"/></td>
                <td style="border-left: 1px solid #000; border-right: 1px solid #000; padding: 5px;" class="text-end"><span t-field="line.amountpaid"/></td>
            </tr>
        </t>

        <t t-set="blank_rows" t-value="chunk_size - len(page)"/>
        <t t-foreach="range(blank_rows)" t-as="i">
            <tr style="height: 30px;">
                <t t-foreach="range(7)" t-as="j">
                    <td style="border-left: 1px solid #000; border-right: 1px solid #000; border-top: 0; border-bottom: 0;"></td>
                </t>
            </tr>
        </t>

        <tr>
            <td colspan="7" style="border-top: 1px solid #000; height: 0px; padding: 0; margin: 0;"></td>
        </tr>
    </tbody>
</table>

                            <t t-if="page == pages[-1]">
                                <div class="row mt-4">
                                    <div class="col-7">
                                        <strong>Amount in Words:</strong><br/>
                                        <span style="text-transform: capitalize;" t-esc="o.currency_id.with_context(lang=o.partner_id.lang).amount_to_text(o.check_amount) + ' Only'"/>
                                        <div style="margin-top: 20px;">
                                            <strong>Remarks:</strong> <span t-esc="o.memo"/>
                                        </div>
                                    </div>
                                    <div class="col-5">
                                        <table style="width: 100%;">
                                            <tr>
                                                <td style="padding: 8px;"><strong>TOTAL PAID</strong></td>
                                                <td class="text-end" style="padding: 8px;">
                                                    <strong t-field="o.check_amount" t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                                </td>
                                            </tr>
                                        </table>
                                    </div>
                                </div>

                                <div style="margin-top: 10px; padding: 15px; page-break-inside: avoid;">
                                    <div class="row">
                                        <div class="col-6">
                                            <strong>Prepared By:</strong><br/><br/>
                                            <div style="width: 150px; border-bottom: 1px solid #000; padding-top: 30px;"/>
                                        </div>
                                        <div class="col-6">
                                            <strong>Received By:</strong><br/>
                                            <span style="font-size: 10px;">Name: ______________________</span><br/>
                                            <span style="font-size: 10px;">ID/Sign: ____________________</span>
                                        </div>
                                    </div>
                                </div>
                            </t>
                            <t t-if="len(pages) &gt; 1 and page != pages[-1]">
                                <div style="page-break-after: always;"/>
                            </t>
                        </t>
                    </div>
                </div>

                <!-- 3. FOOTER -->
                <div class="footer" style="padding: 0 !important; margin: 0 !important; width: 100%!important;position:relative">

            <div class="text-center" style="font-size: 10px; color: #777; padding: 5px 20px;position:absolute;right:0px">
                Page <span class="page"/> of <span class="topage"/>
            </div>

            <div style="width: 100%; margin: 0; padding: 0;">
                <img src="/ies_pdf_reports/static/src/images/footer.jpg" style="width: 100% !important; display: block; margin: 0; padding: 0;"/>
            </div>

        </div>
            </t>
        </t>
    </template>
</odoo>