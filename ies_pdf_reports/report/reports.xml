<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <!-- Paper Format -->
    <record id="paperformat_for_purchase_order_report" model="report.paperformat">
        <field name="name">Purchase Order Custom Paper Format</field>
        <field name="default" eval="False"/>
        <field name="format">A4</field>
         <field name="orientation">Portrait</field>
            <field name="margin_top">0</field>
            <field name="margin_bottom">19</field>
            <field name="margin_left">0</field>
            <field name="margin_right">0</field>
            <field name="header_spacing">0</field>
            <field name="dpi">96</field>
    </record>


    <!-- Purchase Order Report -->
    <record id="action_report_iesi_purchase_order" model="ir.actions.report">
        <field name="name">PO REPORT</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ies_pdf_reports.iesi_report_purchaseorder</field>
        <field name="report_file">ies_pdf_reports.iesi_report_purchaseorder</field>
        <field name="binding_model_id" ref="purchase.model_purchase_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="paperformat_for_purchase_order_report"/>
        <field name="print_report_name">
            (object.name or 'Purchase Order')
        </field>
    </record>

    <record id="action_report_iesi_invoice" model="ir.actions.report">
    <field name="name">Invoice Report</field>
    <field name="model">account.move</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">ies_pdf_reports.iesi_report_invoice</field>
    <field name="report_file">ies_pdf_reports.iesi_report_invoice</field>
    <field name="print_report_name">'Invoice - %s' % (object.name)</field>
    <field name="binding_model_id" ref="account.model_account_move"/>
    <field name="binding_type">report</field>

    <field name="paperformat_id" ref="paperformat_for_purchase_order_report"/>
</record>

    <record id="action_report_iesi_quotation" model="ir.actions.report">
    <field name="name">QUOTATION REPORT</field>
    <field name="model">sale.order</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">ies_pdf_reports.iesi_report_quotation</field>
    <field name="report_file">ies_pdf_reports.iesi_report_quotation</field>
    <field name="binding_model_id" ref="sale.model_sale_order"/>
    <field name="binding_type">report</field>
    <field name="paperformat_id" ref="paperformat_for_purchase_order_report"/>
    <field name="print_report_name">'Quotation - %s' % (object.name)</field>
</record>

</odoo>
