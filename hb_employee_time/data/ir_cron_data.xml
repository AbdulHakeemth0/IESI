<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="employee_visa_expiry_cron" model="ir.cron">
        <field name="name">Employee Visa Expiry Reminder</field>
        <field name="active" eval="True"/>
        <field name="priority">10</field>
        <field name="interval_type">days</field>
        <field name="interval_number">1</field>
        <field name="nextcall" eval="(datetime.utcnow() + timedelta(days=0)).strftime('%Y-%m-%d 12:01:00')"/>
        <field name="model_id" ref="hb_employee_time.model_hr_employee_remainder"/>
        <field name="state">code</field>
        <field name="code">model.send_visa_expire_alert_remainder()</field>

    </record>
</odoo>

