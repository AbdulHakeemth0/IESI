<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_iesi_fix" model="ir.ui.view">
        <field name="name">account.move.form.inherit.iesi</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
           <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="after">
                <field name="description" />
            </xpath>
            <xpath expr="//button[@name='action_print_pdf']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//sheet/notebook" position="inside">
            <page string="Invoice Summary">

                <group>
                    <field name="agreed_amount"/>
                    <field name="additional_work"/>
                    <field name="received_amount"/>
                    <field name="claim_amount"/>
                    <field name="vat_amount" readonly="1"/>
                    <field name="total_amount" readonly="1"/>
<!--                    <field name="balance_amount"/>-->
                </group>

<!--                <group>-->
<!--                    <field name="claim_amount"/>-->
<!--                    <field name="vat_amount" readonly="1"/>-->
<!--                    <field name="total_amount" readonly="1"/>-->
<!--                </group>-->

            </page>
        </xpath>

        </field>
    </record>
    <record id="view_move_tree_inherit" model="ir.ui.view">
        <field name="name">account.move.tree.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_out_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_partner_display_name']" position="after">
                <field name="project_name"/>
            </xpath>
        </field>
    </record>
    <record id="view_move_form_inherit_project_name" model="ir.ui.view">
        <field name="name">account.move.form.inherit.project.name</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <!-- Add field after invoice date -->
            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="project_name"/>
            </xpath>

        </field>
    </record>
    <record id="view_order_form_inherit_custom_desc" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.custom.desc</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                <field name="custom_description" optional="show" />
            </xpath>

<!--            <xpath expr="//field[@name='order_line']/form//field[@name='name']" position="after">-->
<!--                <field name="custom_description" widget="html"/>-->
<!--            </xpath>-->

        </field>
    </record>

   <record id="view_order_form_inherit_remarks" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.remarks</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="arch" type="xml">
        <!-- 'remarks' എന്ന പേര് തിരയുന്നതിന് പകരം നോട്ട്ബുക്കിന്റെ അവസാനം പുതിയ ടാബ് ചേർക്കുന്നു -->
        <xpath expr="//notebook" position="inside">
            <page string="Terms and Condition" name="boq_remarks_tab">
                <group>
                    <field name="boq_remarks" nolabel="1" widget="html"/>
                </group>
            </page>
        </xpath>
    </field>
</record>

    <record id="view_order_form_hide_notes_quote_tab" model="ir.ui.view">
        <field name="name">sale.order.form.hide.notes.quote</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='order_lines']//field[@name='note']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>