<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fire_fighting_item_tree" model="ir.ui.view">
        <field name="name">fire.fighting.item.tree</field>
        <field name="model">fire.fighting.item</field>
        <field name="arch" type="xml">
            <list string="Fire Fighting Items">
                <field name="fire_fighting_item_name"/>
            </list>
        </field>
    </record>

    <record id="view_fire_fighting_item_form" model="ir.ui.view">
        <field name="name">fire.fighting.item.form</field>
        <field name="model">fire.fighting.item</field>
        <field name="arch" type="xml">
            <form string="Fire Fighting Item">
                <sheet>
                    <group>
                        <field name="fire_fighting_item_name"/>
                        <field name="fire_fighting_unit_rate"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_fire_fighting_items" model="ir.actions.act_window">
        <field name="name">Fire Fighting Items</field>
        <field name="res_model">fire.fighting.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_fire_fighting_root" name="Fire Fighting" parent="sale.menu_sale_config" action="action_fire_fighting_items" sequence="10"/>
</odoo>