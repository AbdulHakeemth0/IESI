<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_drainage_item_tree" model="ir.ui.view">
        <field name="name">drainage.item.tree</field>
        <field name="model">drainage.item</field>
        <field name="arch" type="xml">
            <list string="Drainage Items">
                <field name="drainage_item_name"/>
            </list>
        </field>
    </record>

    <record id="view_drainage_item_form" model="ir.ui.view">
        <field name="name">drainage.item.form</field>
        <field name="model">drainage.item</field>
        <field name="arch" type="xml">
            <form string="Drainage Item">
                <sheet>
                    <group>
                        <field name="drainage_item_name"/>
                        <field name="drainage_unit_rate" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

     <record id="action_drinage_items" model="ir.actions.act_window">
        <field name="name">Drainage Items</field>
        <field name="res_model">drainage.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_drainage_root" name="Drainage" parent="sale.menu_sale_config" action="action_drinage_items" sequence="10"/>
</odoo>