<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="project_discipline_view_list" model="ir.ui.view">
        <field name="name">project.discipline.view.list</field>
        <field name="model">project.discipline</field>
        <field name="arch" type="xml">
            <list string="Project Discipline" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="action_project_discipline" model="ir.actions.act_window">
        <field name="name">Project Discipline</field>
        <field name="res_model">project.discipline</field>
        <field name="view_mode">list</field>
    </record>

    <menuitem id="menu_project_decipline_sale"
              name="Project Discipline"
              parent="sale.menu_sale_config"
              action="action_project_discipline"
              sequence="11"/>

</odoo>
