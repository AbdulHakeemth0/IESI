<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
     <record id="view_form_sale_order_wizard" model="ir.ui.view">
        <field name="name">sale.order.wizard.form</field>
        <field name="model">sale.return.wizard</field>
        <field name="arch" type="xml">
            <form string="Return Reason">
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button string="Submit" type="object" name="action_submit" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
     </record>
</odoo>