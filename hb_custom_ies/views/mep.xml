<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_mep_item_tree" model="ir.ui.view">
        <field name="name">mep.item.tree</field>
        <field name="model">mep.item</field>
        <field name="arch" type="xml">
            <list string="MEP Items">
                <field name="mep_name"/>
            </list>
        </field>
    </record>

    <record id="view_mep_item_form" model="ir.ui.view">
        <field name="name">mep.item.form</field>
        <field name="model">mep.item</field>
        <field name="arch" type="xml">
            <form string="MEP Item">
                <sheet>
                    <group>
                        <field name="mep_name"/>
                        <field name="mep_unit_rate" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
     <record id="action_mep_items" model="ir.actions.act_window">
        <field name="name">MEP Items</field>
        <field name="res_model">mep.item</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_mep_root" name="MEP" parent="sale.menu_sale_config" action="action_mep_items" sequence="10"/>
</odoo>