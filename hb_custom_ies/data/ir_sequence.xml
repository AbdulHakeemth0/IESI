<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data noupdate="0">
        <record id="seq_crm_lead_iesi" model="ir.sequence">
            <field name="name">CRM Lead IESI Sequence</field>
            <field name="code">crm.lead.iesi</field>
            <field name="prefix">IESI/CRM/%(y)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
            <field name="company_id" eval="False"/>
        </record>
       <record id="sale_custom_seq" model="ir.sequence">
           <field name="name">Sale Custom Sequence</field>
           <field name="code">sale.custom.seq</field>
           <field name="prefix">IESI/PROP/%(y)s/</field>
           <field name="padding">4</field>
           <field name="number_increment">1</field>
           <field name="company_id" eval="False"/>
       </record>


    </data>
</odoo>