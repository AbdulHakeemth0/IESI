<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="rfq_creation_wizard_view_form" model="ir.ui.view">
        <field name="name">rfq.creation.wizard.view.form</field>
        <field name="model">rfq.creation.wizard</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <form string="Create RFQ">
                <group>
                    <group>
                        <field name="supplier_ids" widget="many2many_tags" invisible="1"/>
                        <field name="project_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="partner_id" invisible="not po_bool"/>
                        <field name="po_bool" invisible="1"/>
                        <field name="dn_bool" invisible="1"/>
                    </group>
                    <group>
                        <field name="picking_type_id" invisible="not po_bool" options="{'no_open':True,'no_create':True}"/>
                    </group>
                </group>
                <notebook>
                    <page name="rfq_wizard_line" string="Products">
                        <field name="item_ids">
                            <list name="Details" editable="bottom">
                                <field name="rfq_wizard_id" column_invisible="1"/>
                                <field name="product_uom_category_id" column_invisible="1"/>
                                <field name="product_id"/>
                                <field name="quantity"/>
                                <field name="uom_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
                <newline/>
                <footer>
                    <button name="action_create_purchase_order"
                            string="Create PO"
                            type="object"
                            invisible="not po_bool"
                            class="oe_highlight"/>
                    <button name="action_create_delivery_order"
                            string="Create DN"
                            type="object"
                            invisible="not dn_bool"
                            class="oe_highlight"/>
                    <button special="cancel" string="Cancel" class="oe_link"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
